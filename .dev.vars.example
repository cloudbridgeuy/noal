# Copy to `.dev.vars` and fill in. `.dev.vars` is git-ignored; this file is not,
# so it must never hold a real value.
#
# `wrangler dev` loads `.dev.vars` as variables, and the deployed Worker reads
# the same names as secrets. `Config::from_env` accepts either.

# 32 random bytes, base64url without padding. Generate one with:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
#
# Rotating this key signs everyone out, because it is the only thing that can
# unseal an existing cookie.
SESSION_KEY=

# From the WorkOS dashboard: Applications -> your app.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Must match a callback URL registered with WorkOS, exactly.
REDIRECT_URI=http://localhost:8787/auth/callback

# Not read by the Worker. `wrangler dev` uses this instead of a real Hyperdrive
# binding, so a local run needs no Cloudflare resource.
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=postgres://user:password@localhost:5432/noal
